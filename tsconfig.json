{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "commonjs",
    "target": "es2020",

    "lib": ["es2020"],
    "types": ["node"],

    "sourceMap": true,

    "declaration": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,

    "isolatedModules": false
  }
}
